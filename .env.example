GOOGLE_AUTH_MODE=service_account        # nebo oauth
GOOGLE_SERVICE_ACCOUNT_FILE=./secrets/service_account.json
DRIVE_FOLDER_ID=                        # složka „Zápisy“
SPREADSHEET_ID=                         # tabulka „Seznamy“ (nativní Google Tabulka)
TEAM_NAME_IN_PDF=HC Stadion Litoměřice
TEAM_SHORT=LIT
SEASON_START_YEAR=2026

# Volitelné – jen pro `cli league` (statistiky všech týmů Ligy juniorů,
# viz README sekce Liga). Google Tabulky:
# - LEAGUE_DB_SPREADSHEET_ID: DB, jediný zdroj pravdy, zapisuje jen
#   `league sync-games`. Syrové listy si založí sám.
# - LEAGUE_SPREADSHEET_ID: stará prezentační „Liga“ – zamrzlá, nahrazuje ji
#   LEAGUE_V2_SPREADSHEET_ID (viz PLAN.MD), zatím ponechaná pro referenci.
# - LEAGUE_V2_SPREADSHEET_ID: „Liga 2.0“ – nová prezentační tabulka, čte
#   z DB přes IMPORTRANGE (živá, viz PLAN.MD).
LEAGUE_DB_SPREADSHEET_ID=
LEAGUE_SPREADSHEET_ID=
LEAGUE_V2_SPREADSHEET_ID=

# LIT „HC LIT jun 2026/27“ (dříve „Seznamy 2.0“, přejmenováno 5. 10. 2026 –
# jen titulek tabulky, ID beze změny; od 26. 9. 2026 živá architektura, viz
# PLAN.MD/PROJECT.MD). Stejný vzor jako Liga: SEZNAMY_DB_SPREADSHEET_ID je
# jediný zdroj pravdy (zapisuje `cli import`/`cli standings`),
# SEZNAMY_V2_SPREADSHEET_ID je prezentační tabulka nad ní přes IMPORTRANGE.
# SEZNAMY_DB_SPREADSHEET_ID je od cutoveru POVINNÁ – bez ní `cli import`/
# `cli standings` skončí chybou.
SEZNAMY_DB_SPREADSHEET_ID=
SEZNAMY_V2_SPREADSHEET_ID=

# Čistě soukromá tabulka pro Seznam hráčů/Trenéři (od 2. 10. 2026, viz
# PLAN.MD) – citlivé osobní údaje (rodné číslo, pojišťovna, telefon, e-mail,
# PIN trenérů), oddělená i od produkční SPREADSHEET_ID i od Seznamy DB.
# Servisní účet k ní má jen roli Prohlížeč, nikdy se do ní nezapisuje přes
# API – trenér ji edituje ručně. POVINNÁ pro `cli check` a pro
# scripts/build_seznamy_v2_mirrors.py (zrcadlí odtud jen neosobní sloupce
# B:F Seznamu hráčů do HC LIT jun 2026/27).
SEZNAMY_PRIVATE_SPREADSHEET_ID=

# pre-scout (od 20. 10. 2026, viz PLAN.MD) – klipy gólů/přesilovek příštího
# soupeře z czechicehockey.tv (účet s předplatným VOD, NE Google), modul
# `statistic_table.prescout`. Vyžaduje ffmpeg v PATH.
# - WEB_LOGIN/WEB_PASSWD: přihlášení na czechicehockey.tv.
# - PRE_SCOUT_DRIVE_FOLDER_ID: složka na Disku (založená ručně v účtu
#   hc.lit.juniori@gmail.com), kam se po týmech nahrávají MP4 klipy.
#   Servisní účet na běžném Google účtu nemá vlastní úložiště pro OBSAH
#   souborů ("Service Accounts do not have storage quota") – nahrávání
#   proto běží přes OAuth za REÁLNÉHO uživatele (GOOGLE_OAUTH_* níž), ne
#   přes GOOGLE_SERVICE_ACCOUNT_FILE – viz PLAN.MD, 21. 10. 2026.
# - GOOGLE_OAUTH_CLIENT_SECRETS_FILE: OAuth client ID (typ "Desktop app"),
#   založený v Google Cloud Console (stejný projekt jako servisní účet,
#   APIs & Services > Credentials > Create Credentials > OAuth client ID
#   > Desktop app) a stažený jako JSON do `secrets/` (v gitu ignorováno).
# - GOOGLE_OAUTH_TOKEN_FILE: kam se po prvním přihlášení (otevře se
#   prohlížeč, jednorázový souhlas za hc.lit.juniori@gmail.com) uloží
#   refresh token – další spuštění už prohlížeč neotevírají.
WEB_LOGIN=
WEB_PASSWD=
PRE_SCOUT_DRIVE_FOLDER_ID=
GOOGLE_OAUTH_CLIENT_SECRETS_FILE=./secrets/oauth_client_secrets.json
GOOGLE_OAUTH_TOKEN_FILE=./secrets/oauth_token.json
