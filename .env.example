GOOGLE_AUTH_MODE=service_account        # nebo oauth
GOOGLE_SERVICE_ACCOUNT_FILE=./secrets/service_account.json
DRIVE_FOLDER_ID=                        # složka „Zápisy“
SPREADSHEET_ID=                         # tabulka „Seznamy“ (nativní Google Tabulka)
TEAM_NAME_IN_PDF=HC Stadion Litoměřice
TEAM_SHORT=LIT
SEASON_START_YEAR=2026

# Volitelné – jen pro `cli league` (statistiky všech týmů Ligy juniorů,
# viz README sekce Liga). Google Tabulky:
# - LEAGUE_DB_SPREADSHEET_ID: DB, jediný zdroj pravdy, zapisuje jen
#   `league sync-games`. Syrové listy si založí sám.
# - LEAGUE_SPREADSHEET_ID: stará prezentační „Liga“ – zamrzlá, nahrazuje ji
#   LEAGUE_V2_SPREADSHEET_ID (viz PLAN.MD), zatím ponechaná pro referenci.
# - LEAGUE_V2_SPREADSHEET_ID: „Liga 2.0“ – nová prezentační tabulka, čte
#   z DB přes IMPORTRANGE (živá, viz PLAN.MD).
LEAGUE_DB_SPREADSHEET_ID=
LEAGUE_SPREADSHEET_ID=
LEAGUE_V2_SPREADSHEET_ID=

# LIT Seznamy 2.0 (od 26. 9. 2026 živá architektura, viz PLAN.MD/PROJECT.MD).
# Stejný vzor jako Liga: SEZNAMY_DB_SPREADSHEET_ID je jediný zdroj pravdy
# (zapisuje `cli import`/`cli standings`), SEZNAMY_V2_SPREADSHEET_ID je
# prezentační tabulka nad ní přes IMPORTRANGE. SEZNAMY_DB_SPREADSHEET_ID je
# od cutoveru POVINNÁ – bez ní `cli import`/`cli standings` skončí chybou.
# Produkční SPREADSHEET_ID („Seznamy“) zůstává živá jen pro listy Seznam
# hráčů a Trenéři (trenér je edituje ručně), Zápasy/Sestavy tam už skript
# nezapisuje.
SEZNAMY_DB_SPREADSHEET_ID=
SEZNAMY_V2_SPREADSHEET_ID=
